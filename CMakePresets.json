{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install"
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HPGL_BUILD_PYTHON": "ON",
        "HPGL_BUILD_TESTS": "ON",
        "HPGL_USE_OPENMP": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HPGL_BUILD_PYTHON": "ON",
        "HPGL_BUILD_TESTS": "ON",
        "HPGL_USE_OPENMP": "ON"
      }
    },
    {
      "name": "release-mkl",
      "displayName": "Release with Intel MKL",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HPGL_BUILD_TESTS": "ON",
        "HPGL_USE_MKL": "ON",
        "HPGL_USE_OPENMP": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows (MSVC)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HPGL_BUILD_TESTS": "ON",
        "HPGL_USE_MKL": "ON"
      }
    },
    {
      "name": "linux-ninja",
      "displayName": "Linux (Ninja)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HPGL_BUILD_TESTS": "ON",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS (Clang)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HPGL_BUILD_TESTS": "ON",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release-mkl",
      "displayName": "Build Release with MKL",
      "configurePreset": "release-mkl"
    },
    {
      "name": "windows-msvc",
      "displayName": "Build Windows (MSVC)",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "linux-ninja",
      "displayName": "Build Linux (Ninja)",
      "configurePreset": "linux-ninja"
    },
    {
      "name": "macos-clang",
      "displayName": "Build macOS (Clang)",
      "configurePreset": "macos-clang"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release-mkl",
      "displayName": "Test Release with MKL",
      "configurePreset": "release-mkl"
    },
    {
      "name": "windows-msvc",
      "displayName": "Test Windows (MSVC)",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "linux-ninja",
      "displayName": "Test Linux (Ninja)",
      "configurePreset": "linux-ninja"
    },
    {
      "name": "macos-clang",
      "displayName": "Test macOS (Clang)",
      "configurePreset": "macos-clang"
    }
  ]
}
